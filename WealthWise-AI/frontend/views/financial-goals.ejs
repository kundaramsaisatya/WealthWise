
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Financial Goals | WealthWise AI</title>

    <link rel="stylesheet" href="/style.css">

    <style>
        .goals-container {
            padding: 30px;
            max-width: 1200px;
            margin: auto;
        }

        .goals-header {
            margin: 25px 0;
        }

        .goals-header h1 {
            margin: 8px 0;
        }

        .goals-header p {
            color: #64748b;
        }

        .goal-form-card {
            background: #fff;
            padding: 25px;
            border-radius: 14px;
            border: 1px solid #e5e7eb;
            margin-top: 25px;
        }

        .goal-form-card h3 {
            margin-top: 0;
            margin-bottom: 22px;
        }

        .goal-form {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group label {
            font-size: 14px;
            font-weight: 600;
            color: #26364b;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            box-sizing: border-box;
            padding: 13px 14px;
            border: 1px solid #dce2e8;
            border-radius: 9px;
            font-size: 14px;
            background: #fff;
            color: #26364b;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #07845f;
            box-shadow: 0 0 0 3px rgba(7, 132, 95, 0.1);
        }

        .field-help {
            color: #8491a3;
            font-size: 11px;
        }

        .form-actions {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .form-actions button {
            min-width: 150px;
        }

        .goal-message {
            margin-top: 15px;
            font-size: 14px;
        }

        .goal-message.success {
            color: #07845f;
        }

        .goal-message.error {
            color: #dc2626;
        }

        .goals-section {
            margin-top: 35px;
        }

        .goals-section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .goal-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .goal-card {
            background: #fff;
            padding: 23px;
            border-radius: 14px;
            border: 1px solid #e5e7eb;
        }

        .goal-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
        }

        .goal-card h3 {
            margin: 0 0 7px;
            color: #172b45;
            font-size: 18px;
        }

        .goal-category {
            color: #64748b;
            font-size: 12px;
        }

        .goal-status {
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 11px;
            background: #dcfce7;
            color: #166534;
            white-space: nowrap;
        }

        .progress-label {
            display: flex;
            justify-content: space-between;
            margin-top: 22px;
            font-size: 12px;
            color: #64748b;
        }

        .progress-track {
            height: 9px;
            background: #e5e7eb;
            border-radius: 20px;
            margin: 10px 0 18px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: #07845f;
            border-radius: 20px;
        }

        .goal-metric {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin: 13px 0;
            font-size: 13px;
            color: #64748b;
        }

        .goal-metric strong {
            color: #172b45;
            text-align: right;
        }

        .goal-divider {
            border: none;
            border-top: 1px solid #edf0f3;
            margin: 17px 0;
        }

        .goal-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .goal-actions button {
            padding: 9px 15px;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
        }

        .edit-btn {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .delete-btn {
            background: #fee2e2;
            color: #b91c1c;
        }

        .empty-goals {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 35px;
            text-align: center;
            color: #64748b;
        }

        .empty-goals h3 {
            color: #172b45;
        }

        .disclaimer {
            margin-top: 30px;
            font-size: 12px;
            color: #8491a3;
            line-height: 1.6;
        }

        @media(max-width: 650px) {
            .goals-container {
                padding: 16px;
            }

            .goal-form {
                grid-template-columns: 1fr;
            }

            .goal-form-card {
                padding: 18px;
            }

            .goals-section-header {
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>

<div class="goals-container">

    <a href="/" class="secondary-btn">
        ← Back to Dashboard
    </a>

    <div class="goals-header">

        <span class="eyebrow">FINANCIAL PLANNING</span>

        <h1>Financial Goals</h1>

        <p>
            Plan, track and monitor your financial milestones.
        </p>

    </div>


    <!-- CREATE GOAL FORM -->

    <div class="goal-form-card">

        <h3 id="form-title">
            Create a Financial Goal
        </h3>

        <form id="goal-form" class="goal-form">

            <div class="form-group">

                <label for="goal-name">
                    Goal Name
                </label>

                <input
                    id="goal-name"
                    name="name"
                    type="text"
                    placeholder="e.g. Buy a House"
                    maxlength="100"
                    required
                >

            </div>


            <div class="form-group">

                <label for="goal-category">
                    Goal Category
                </label>

                <select
                    id="goal-category"
                    name="category"
                    required
                >
                    <option value="">Select category</option>
                    <option>Retirement</option>
                    <option>House</option>
                    <option>Education</option>
                    <option>Travel</option>
                    <option>Emergency Fund</option>
                    <option>Other</option>
                </select>

            </div>


            <div class="form-group">

                <label for="target-amount">
                    Target Amount (₹)
                </label>

                <input
                    id="target-amount"
                    name="targetAmount"
                    type="number"
                    placeholder="e.g. 5000000"
                    min="1"
                    step="0.01"
                    required
                >

            </div>


            <div class="form-group">

                <label for="current-savings">
                    Current Savings (₹)
                </label>

                <input
                    id="current-savings"
                    name="currentSavings"
                    type="number"
                    placeholder="e.g. 500000"
                    min="0"
                    step="0.01"
                    value="0"
                >

            </div>


            <div class="form-group">

                <label for="target-date">
                    Target Date
                </label>

                <input
                    id="target-date"
                    name="targetDate"
                    type="date"
                    required
                >

            </div>


            <div class="form-group">

                <label for="monthly-contribution">
                    Planned Monthly Contribution (₹)
                </label>

                <input
                    id="monthly-contribution"
                    name="monthlyContribution"
                    type="number"
                    placeholder="e.g. 25000"
                    min="0"
                    step="0.01"
                    value="0"
                >

            </div>


            <div class="form-group">

                <label for="inflation-rate">
                    Expected Inflation Rate (%)
                </label>

                <input
                    id="inflation-rate"
                    name="inflationRate"
                    type="number"
                    min="0"
                    max="30"
                    step="0.1"
                    value="6"
                >

                <span class="field-help">
                    Assumed yearly increase in goal cost.
                </span>

            </div>


            <div class="form-group">

                <label for="expected-return">
                    Expected Annual Return (%)
                </label>

                <input
                    id="expected-return"
                    name="expectedAnnualReturn"
                    type="number"
                    min="0"
                    max="50"
                    step="0.1"
                    value="10"
                >

                <span class="field-help">
                    Illustrative annual investment return assumption.
                </span>

            </div>


            <div class="form-actions">

                <button
                    type="submit"
                    class="primary-btn"
                    id="save-btn"
                >
                    Create Goal
                </button>

                <button
                    type="button"
                    class="secondary-btn"
                    id="cancel-edit"
                    hidden
                >
                    Cancel Edit
                </button>

            </div>

        </form>

        <p
            id="goal-message"
            class="goal-message"
            role="status"
            aria-live="polite"
        ></p>

    </div>


    <!-- GOALS LIST -->

    <section class="goals-section">

        <div class="goals-section-header">

            <h2>Your Financial Goals</h2>

            <span id="goal-count">
                0 goals
            </span>

        </div>

        <div id="goal-list" class="goal-grid">
            Loading goals...
        </div>

    </section>


    <p class="disclaimer">
        Financial projections are estimates based on the assumptions entered.
        Actual investment returns and inflation may differ.
        These calculations are illustrative and are not investment advice.
    </p>

</div>


<script>

    const form = document.getElementById("goal-form");

    const goalList = document.getElementById("goal-list");

    const message = document.getElementById("goal-message");

    const saveButton = document.getElementById("save-btn");

    let editingId = null;

    let goals = [];


    // CURRENCY FORMATTER

    function currency(value) {

        return "₹" + Number(value).toLocaleString("en-IN", {
            maximumFractionDigits: 0
        });

    }


    // SAFE HTML TEXT

    function escapeHTML(value) {

        return String(value ?? "").replace(/[&<>"']/g, char => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;"
        })[char]);

    }


    // MESSAGE HANDLER

    function showMessage(text, type) {

        message.textContent = text;

        message.className = "goal-message " + type;

    }


    // LOAD GOALS

    async function loadGoals() {

        goalList.textContent = "Loading goals...";

        try {

            const response = await fetch("/goals");

            if (!response.ok) {
                throw new Error("Unable to load financial goals.");
            }

            const data = await response.json();

            goals = data.goals || [];

            document.getElementById("goal-count").textContent =
                `${goals.length} goals`;

            renderGoals();

        } catch (error) {

            goalList.textContent = error.message;

        }

    }


    // RENDER GOAL CARDS

    function renderGoals() {

        if (!goals.length) {

            goalList.innerHTML = `
                <div class="empty-goals">
                    <h3>No financial goals yet</h3>
                    <p>
                        Create your first financial goal using the form above.
                    </p>
                </div>
            `;

            return;

        }


        goalList.innerHTML = goals.map(goal => {

            const plan = goal.plan;

            const progress = Math.min(
                100,
                Math.max(
                    0,
                    Number(plan.projected_progress_percentage) || 0
                )
            );

            return `

                <div class="goal-card">

                    <div class="goal-card-header">

                        <div>

                            <h3>${escapeHTML(goal.name)}</h3>

                            <span class="goal-category">
                                ${escapeHTML(goal.category)}
                            </span>

                        </div>

                        <span class="goal-status">
                            ${escapeHTML(goal.status)}
                        </span>

                    </div>


                    <div class="progress-label">

                        <span>Projected progress</span>

                        <strong>${progress.toFixed(1)}%</strong>

                    </div>


                    <div class="progress-track">

                        <div
                            class="progress-fill"
                            style="width:${progress}%"
                        ></div>

                    </div>


                    <div class="goal-metric">

                        <span>Target amount today</span>

                        <strong>
                            ${currency(goal.targetAmount)}
                        </strong>

                    </div>


                    <div class="goal-metric">

                        <span>Future target</span>

                        <strong>
                            ${currency(plan.future_target)}
                        </strong>

                    </div>


                    <div class="goal-metric">

                        <span>Current savings</span>

                        <strong>
                            ${currency(goal.currentSavings)}
                        </strong>

                    </div>


                    <hr class="goal-divider">


                    <div class="goal-metric">

                        <span>Required monthly investment</span>

                        <strong>
                            ${currency(plan.required_monthly_investment)}
                        </strong>

                    </div>


                    <div class="goal-metric">

                        <span>Planned monthly contribution</span>

                        <strong>
                            ${currency(goal.monthlyContribution)}
                        </strong>

                    </div>


                    <div class="goal-metric">

                        <span>Time remaining</span>

                        <strong>
                            ${plan.months_remaining} months
                        </strong>

                    </div>


                    <div class="goal-actions">

                        <button
                            type="button"
                            class="edit-btn"
                            onclick="editGoal('${goal._id}')"
                        >
                            Edit
                        </button>

                        <button
                            type="button"
                            class="delete-btn"
                            onclick="deleteGoal('${goal._id}')"
                        >
                            Delete
                        </button>

                    </div>

                </div>

            `;

        }).join("");

    }


    // CREATE OR UPDATE GOAL

    form.addEventListener("submit", async function(event) {

        event.preventDefault();

        showMessage("", "");

        const formData = new FormData(form);

        const payload = Object.fromEntries(formData.entries());


        // Convert numeric fields

        const numericFields = [
            "targetAmount",
            "currentSavings",
            "monthlyContribution",
            "inflationRate",
            "expectedAnnualReturn"
        ];

        numericFields.forEach(field => {

            payload[field] = Number(payload[field]);

        });


        try {

            saveButton.disabled = true;

            saveButton.textContent = "Saving...";


            const response = await fetch(
                editingId
                    ? `/goals/${editingId}`
                    : "/goals",
                {
                    method: editingId ? "PUT" : "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify(payload)
                }
            );


            const result = await response.json();


            if (!response.ok) {

                throw new Error(
                    result.errors?.join(" ") ||
                    result.error ||
                    "Unable to save financial goal."
                );

            }


            const successMessage = result.message;

            resetForm();

            showMessage(successMessage, "success");

            await loadGoals();

        } catch (error) {

            showMessage(error.message, "error");

        } finally {

            saveButton.disabled = false;

            saveButton.textContent = editingId
                ? "Update Goal"
                : "Create Goal";

        }

    });


    // EDIT GOAL

    function editGoal(id) {

        const goal = goals.find(item => item._id === id);

        if (!goal) return;

        editingId = id;


        form.elements["name"].value = goal.name;

        form.elements["category"].value = goal.category;

        form.elements["targetAmount"].value = goal.targetAmount;

        form.elements["currentSavings"].value = goal.currentSavings;

        form.elements["targetDate"].value =
            new Date(goal.targetDate).toISOString().slice(0, 10);

        form.elements["monthlyContribution"].value =
            goal.monthlyContribution;

        form.elements["inflationRate"].value =
            goal.inflationRate;

        form.elements["expectedAnnualReturn"].value =
            goal.expectedAnnualReturn;


        document.getElementById("form-title").textContent =
            "Edit Financial Goal";

        saveButton.textContent = "Update Goal";

        document.getElementById("cancel-edit").hidden = false;


        showMessage("", "");

        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });

    }


    // DELETE GOAL

    async function deleteGoal(id) {

        const confirmed = confirm(
            "Are you sure you want to delete this financial goal?"
        );

        if (!confirmed) return;


        try {

            const response = await fetch(`/goals/${id}`, {
                method: "DELETE"
            });

            const result = await response.json();


            if (!response.ok) {

                throw new Error(
                    result.error || "Unable to delete goal."
                );

            }


            showMessage(result.message, "success");

            await loadGoals();

        } catch (error) {

            showMessage(error.message, "error");

        }

    }


    // RESET FORM

    function resetForm() {

        form.reset();

        editingId = null;


        document.getElementById("form-title").textContent =
            "Create a Financial Goal";

        saveButton.textContent = "Create Goal";

        document.getElementById("cancel-edit").hidden = true;

    }


    // CANCEL EDIT

    document.getElementById("cancel-edit").addEventListener(
        "click",
        function() {

            resetForm();

            showMessage("", "");

        }
    );


    // INITIAL LOAD

    loadGoals();

</script>

</body>
</html>
