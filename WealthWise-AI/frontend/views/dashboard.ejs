<%
    const safeAnalytics = typeof analytics !== "undefined" ? analytics : null;
    const safeRisk = typeof risk !== "undefined" ? risk : null;
    const safeError = typeof error !== "undefined" ? error : null;

    const safePortfolio =
        typeof portfolio !== "undefined" && portfolio
            ? portfolio
            : { holdings: [], totalValue: 0, currency: "INR" };

    const safeAllDocumentHoldings =
        Array.isArray(allDocumentHoldings) ? allDocumentHoldings : [];

    const safeDuplicateRecords =
        Array.isArray(duplicateRecords) ? duplicateRecords : [];

    const safeConflicts =
        Array.isArray(conflicts) ? conflicts : [];

    const folioVerificationRecords = Array.from(
        new Map(
            safeAllDocumentHoldings
                .filter(item => item.folioVerification?.folio_number)
                .map(item => [String(item.folioVerification.folio_number).replace(/\\s+/g, "").toUpperCase(), item.folioVerification])
        ).values()
    );
    const folioVerificationIssues = folioVerificationRecords.filter(item => {
        const kyc = String(item.kyc_status || "").toLowerCase();
        const nominee = String(item.nominee_status || "").toLowerCase();
        return item.verification_note ||
            (kyc && !/^(kyc )?ok$|^verified$|^complete$/.test(kyc)) ||
            (nominee && !/^(registered|not applicable|n a)$/.test(nominee));
    });

    // The dashboard can also render on fallback/error paths where the
    // server has not supplied accountSelection.
    const safeAccountSelection =
        typeof accountSelection !== "undefined" && accountSelection
            ? {
                activeAccountHolder: accountSelection.activeAccountHolder || null,
                identityUnverified: accountSelection.identityUnverified === true,
                excludedDocuments: Array.isArray(accountSelection.excludedDocuments)
                    ? accountSelection.excludedDocuments
                    : []
            }
            : { activeAccountHolder: null, identityUnverified: false, excludedDocuments: [] };

    const portfolioHoldings = Array.isArray(safePortfolio.holdings)
        ? safePortfolio.holdings
        : [];

    const analyticsHoldings =
        safeAnalytics && Array.isArray(safeAnalytics.holdings)
            ? safeAnalytics.holdings
            : [];

    const formatCurrency = value => {
        if (
            value === null ||
            value === undefined ||
            value === "" ||
            !Number.isFinite(Number(value))
        ) return "N/A";

        return "₹" + Number(value).toLocaleString("en-IN", {
            maximumFractionDigits: 2
        });
    };

    const isPartialPortfolio = safePortfolio.isPartial === true;

    const totalValue = isPartialPortfolio
        ? safePortfolio.verifiedTotalValue
        : Number(safeAnalytics?.total_value ?? safePortfolio.totalValue ?? 0);

    const totalInvested =
        safeAnalytics?.total_invested !== undefined
            ? safeAnalytics.total_invested
            : null;

    const totalProfitLoss =
        safeAnalytics?.profit_loss !== undefined
            ? safeAnalytics.profit_loss
            : null;

    const profitLossPercentage =
        safeAnalytics?.profit_loss_percentage ?? null;

    const portfolioMode = safePortfolio.isDemo
        ? "Demo data"
        : "Actual data";

    const sourceDocumentCount = new Set(
        safeAllDocumentHoldings
            .map(item => item.documentName)
            .filter(Boolean)
    ).size;

    const hasExtraDetails = portfolioHoldings.some(item =>
        item.subCategory ||
        item.isin ||
        item.folioNumber ||
        item.source ||
        item.averageNav != null ||
        item.currentNav != null
    );

    const riskFlags = Array.isArray(safeRisk?.risk_flags)
        ? safeRisk.risk_flags
        : [];

    const analyticsRiskFlags = Array.isArray(safeAnalytics?.risk_flags)
        ? safeAnalytics.risk_flags
        : [];

    const allocationData = Array.isArray(safeAnalytics?.asset_allocation)
        ? safeAnalytics.asset_allocation
        : [];

    const getConflictName = item =>
        item?.name ||
        item?.holdingName ||
        item?.investment ||
        item?.isin ||
        "Investment record";

    const getConflictMessage = item =>
        item?.message ||
        item?.reason ||
        "Different values were found across uploaded documents.";

    const getConflictValues = item => {
        if (Array.isArray(item?.values)) return item.values;

        if (Array.isArray(item?.conflictingValues)) {
            return item.conflictingValues.map(value =>
                typeof value === "object" ? value.currentValue : value
            );
        }

        return [];
    };

    const getSelectedDocument = item =>
        item?.selectedDocument ||
        item?.selectedSource ||
        item?.documentName ||
        "Not specified";

    const safeJson = value =>
        JSON.stringify(value ?? []).replace(/</g, "\\u003c");
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>WealthWise AI | Wealth Dashboard</title>

    <link rel="stylesheet" href="/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

<div class="app-layout">

    <!-- SIDEBAR -->

    <aside class="sidebar" id="sidebar">

        <div class="brand">
            <div class="brand-icon">W</div>
            <div>
                <h2>WealthWise <span>AI</span></h2>
                <p>WEALTH INTELLIGENCE</p>
            </div>
        </div>

        <div class="sidebar-user">
            <div class="user-avatar">
                <%= (user?.name || "U").charAt(0).toUpperCase() %>
            </div>
            <div class="user-details">
                <strong><%= user?.name || "User" %></strong>
                <small>Personal account</small>
            </div>
        </div>

        <nav class="sidebar-nav">

            <span class="nav-heading">WORKSPACE</span>

            <a href="#overview" class="nav-link active">
                <span class="nav-icon">▦</span>
                Overview
            </a>

            <a href="#portfolio" class="nav-link">
                <span class="nav-icon">◫</span>
                Portfolio
            </a>

            <a href="#risk-analysis" class="nav-link">
                <span class="nav-icon">⌁</span>
                Analytics & Risk
            </a>
            <a href="/financial-goals" class="nav-link">
                <span class="nav-icon">◎</span>
                Financial Goals
            </a>
            <a href="/profile" class="nav-link">
                <span class="nav-icon">⚙</span>
                Profile Settings
            </a>

            <span class="nav-heading">MANAGEMENT</span>

            <a href="#documents" class="nav-link">
                <span class="nav-icon">▤</span>
                Documents
            </a>

            <a href="#reconciliation" class="nav-link">
                <span class="nav-icon">⇄</span>
                Reconciliation
            </a>

            <span class="nav-heading">INTELLIGENCE</span>

            <a href="#assistant" class="nav-link">
                <span class="nav-icon">✧</span>
                AI Assistant
            </a>

        </nav>

        <div class="sidebar-bottom">

            <div class="sidebar-status">
                <span class="status-dot"></span>
                WealthWise AI
                <small>Financial intelligence platform</small>
            </div>

            <form action="/logout" method="POST">
                <button type="submit" class="logout-btn">
                    <span>↪</span> Sign out
                </button>
            </form>

        </div>

    </aside>


    <!-- MAIN WORKSPACE -->

    <main class="main-content">

        <!-- TOPBAR -->

        <div class="topbar">
            <div class="topbar-left">
                <button class="mobile-menu-btn" id="mobile-menu-btn"
                    type="button" aria-label="Toggle navigation">
                    ☰
                </button>

                <div>
                    <span class="breadcrumb">Workspace / Overview</span>
                </div>
            </div>

            <div class="topbar-right">
                <span class="data-status">
                    <span class="status-dot"></span>
                    <%= portfolioMode %>
                </span>
            </div>
        </div>


        <!-- ERROR MESSAGE -->

        <% if (safeError) { %>
            <div class="alert alert-error">
                <strong>Dashboard notice</strong>
                <p><%= safeError %></p>
            </div>
        <% } %>


        <% if (isPartialPortfolio) { %>
            <div class="alert alert-account-review" role="alert">
                <strong>Portfolio valuation is incomplete</strong>
                <p>
                    <%= safePortfolio.unverifiedHoldingCount %> holding(s) have missing or conflicting values.
                    The amount below is only the verified subtotal; total portfolio value and risk assessment are withheld until the records are resolved.
                </p>
            </div>
        <% } %>

        <% if (safeAccountSelection.excludedDocuments?.length) { %>
            <div class="alert alert-account-review" role="status">
                <strong>
                    <%= safeAccountSelection.identityUnverified
                        ? "Account ownership could not be verified across statements"
                        : "Some statements were kept out of this portfolio" %>
                </strong>
                <p>
                    <% if (safeAccountSelection.identityUnverified) { %>
                        No statement contained a verified account-holder name. WealthWise
                        is showing only the newest single statement and is not combining
                        other documents. Confirm ownership before relying on this portfolio.
                    <% } else { %>
                        WealthWise selected <%= safeAccountSelection.activeAccountHolder %>
                        as the active account holder. Statements with a different or
                        unverified account holder are excluded to prevent mixing accounts.
                    <% } %>
                </p>
                <ul>
                    <% safeAccountSelection.excludedDocuments.forEach(item => { %>
                        <li>
                            <strong><%= item.documentName %></strong>
                            — <%= item.reason %>
                            <% if (item.accountHolder) { %>
                                (Account holder: <%= item.accountHolder %>)
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <!-- OVERVIEW -->

        <section id="overview" class="page-section">

            <div class="page-heading">
                <div>
                    <span class="eyebrow">YOUR FINANCIAL OVERVIEW</span>
                    <h1>Portfolio Overview</h1>
                    <p>Monitor your wealth, investments and financial position.</p>
                </div>

                <a href="#documents" class="primary-btn">
                    + Add documents
                </a>
            </div>


            <% if (safeAnalytics) { %>

                <!-- KEY METRICS -->

                <div class="metric-grid">

                    <div class="metric-card primary-metric">
                        <div class="metric-top">
                            <span><%= isPartialPortfolio ? "Verified Holdings Subtotal" : "Total Portfolio Value" %></span>
                            <span class="metric-icon">₹</span>
                        </div>

                        <h2>
                            <%= formatCurrency(totalValue) %>
                        </h2>

                        <small>
                            <%= isPartialPortfolio
                                ? "Partial value only — some holdings need verification"
                                : "Based on the selected account's current statements" %>
                        </small>
                    </div>


                    <div class="metric-card">
                        <div class="metric-top">
                            <span>Total Invested</span>
                            <span class="metric-icon">↗</span>
                        </div>

                        <h2><%= formatCurrency(totalInvested) %></h2>
                        <small>Available cost-basis information</small>
                    </div>


                    <div class="metric-card">
                        <div class="metric-top">
                            <span>Profit / Loss</span>
                            <span class="metric-icon">±</span>
                        </div>

                        <h2 class="<%= totalProfitLoss === null ? '' : Number(totalProfitLoss) >= 0 ? 'positive' : 'negative' %>">
                            <%= formatCurrency(totalProfitLoss) %>
                        </h2>

                        <small>
                            <%= profitLossPercentage !== null
                                ? Number(profitLossPercentage).toFixed(2) + "% simple return"
                                : "Return unavailable" %>
                        </small>
                    </div>


                    <div class="metric-card">
                        <div class="metric-top">
                            <span>Consolidated Holdings</span>
                            <span class="metric-icon">▤</span>
                        </div>

                        <h2><%= analyticsHoldings.length %></h2>
                        <small>Investment records</small>
                    </div>

                </div>


                <!-- CHARTS -->

                <div class="section-heading">
                    <div>
                        <h2>Portfolio Composition</h2>
                        <p>Understand how your investments are distributed.</p>
                    </div>
                </div>

                <div class="dashboard-grid charts-grid">

                    <div class="content-card chart-card">
                        <div class="card-heading">
                            <div>
                                <h3>Asset Allocation</h3>
                                <p>Distribution across asset classes</p>
                            </div>
                        </div>

                        <% if (allocationData.length > 0) { %>
                            <div class="chart-container doughnut-container">
                                <canvas id="allocationChart"></canvas>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <span>◉</span>
                                <p>No asset allocation data available.</p>
                            </div>
                        <% } %>
                    </div>


                    <div class="content-card chart-card">
                        <div class="card-heading">
                            <div>
                                <h3>Largest Holdings</h3>
                                <p>Current value by investment</p>
                            </div>
                        </div>

                        <% if (analyticsHoldings.length > 0) { %>
                            <div class="chart-container holdings-chart-container">
                                <canvas id="holdingsChart"></canvas>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <span>▥</span>
                                <p>No holding data available.</p>
                            </div>
                        <% } %>
                    </div>

                </div>


                <!-- PORTFOLIO HIGHLIGHTS -->

                <div class="section-heading">
                    <div>
                        <h2>Portfolio Highlights</h2>
                        <p>Important observations from your current portfolio.</p>
                    </div>

                    <a href="#risk-analysis" class="text-link">
                        View risk analysis →
                    </a>
                </div>

                <div class="dashboard-grid highlight-grid">

                    <div class="content-card highlight-card">
                        <span class="highlight-label">Largest Holding</span>

                        <h3>
                            <%= safeAnalytics.largest_holding?.name || "N/A" %>
                        </h3>

                        <div class="highlight-value">
                            <%= formatCurrency(safeAnalytics.largest_holding?.value) %>
                        </div>

                        <small>
                            <%= safeAnalytics.largest_holding?.weight_percentage ?? "N/A" %>%
                            of portfolio
                        </small>
                    </div>


                    <div class="content-card highlight-card">
                        <span class="highlight-label">Top 3 Concentration</span>

                        <h3>
                            <%= safeAnalytics.concentration?.top_three_concentration ?? "N/A" %>%
                        </h3>

                        <small>Combined weight of three largest holdings</small>
                    </div>


                    <div class="content-card highlight-card">
                        <span class="highlight-label">Cash / Liquid Allocation</span>

                        <h3>
                            <%= safeAnalytics.liquidity?.percentage ?? "N/A" %>%
                        </h3>

                        <small>Reported Cash / Liquid asset allocation</small>
                    </div>

                </div>


                <!-- RECENT DATA SUMMARY -->

                <div class="content-card summary-card">
                    <div class="card-heading">
                        <div>
                            <h3>Data Summary</h3>
                            <p>Overview of your uploaded financial information.</p>
                        </div>
                    </div>

                    <div class="summary-grid">
                        <div>
                            <span>Extracted records</span>
                            <strong><%= safeAllDocumentHoldings.length %></strong>
                        </div>

                        <div>
                            <span>Source documents</span>
                            <strong><%= sourceDocumentCount %></strong>
                        </div>

                        <div>
                            <span>Duplicate groups</span>
                            <strong><%= safeDuplicateRecords.length %></strong>
                        </div>

                        <div>
                            <span>Valuation differences</span>
                            <strong><%= safeConflicts.length %></strong>
                        </div>
                    </div>
                </div>

            <% } else { %>

                <div class="welcome-card">
                    <div class="welcome-icon">✧</div>
                    <span class="eyebrow">GET STARTED</span>
                    <h2>Welcome to WealthWise AI</h2>
                    <p>
                        Bring your financial documents together to build
                        a consolidated view of your wealth.
                    </p>
                    <a href="#documents" class="primary-btn">
                        Upload your first document
                    </a>
                </div>

            <% } %>

        </section>


        <!-- PORTFOLIO -->

        <section id="portfolio" class="page-section">

            <div class="page-heading">
                <div>
                    <span class="eyebrow">INVESTMENT MANAGEMENT</span>
                    <h1>Portfolio Holdings</h1>
                    <p>Review your consolidated investments and their performance.</p>
                </div>
            </div>


            <div class="content-card">
                <div class="content-card" id="performance-card">
                    <div class="card-heading">
                        <div>
                            <h3>Historical Portfolio Performance</h3>
                            <p>Track how your portfolio value changes across statement dates.</p>
                        </div>
                    </div>

                    <div id="performance-message">
                        Loading historical performance...
                    </div>

                    <div style="height: 320px;">
                        <canvas id="performanceChart"></canvas>
                    </div>
                </div>

                <div class="card-heading">
                    <div>
                        <h3>Consolidated Investments</h3>
                        <p>One view of your recognized portfolio holdings.</p>
                    </div>

                    <span class="count-badge">
                        <%= analyticsHoldings.length %> holdings
                    </span>
                </div>

                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Investment</th>
                                <th>Asset Class</th>
                                <th>Invested Value</th>
                                <th>Current Value</th>
                                <th>Profit / Loss</th>
                                <th>Weight</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% analyticsHoldings.forEach(item => { %>
                                <tr>
                                    <td class="investment-name">
                                        <strong><%= item.name || "Unnamed investment" %></strong>
                                    </td>

                                    <td>
                                        <span class="category-tag">
                                            <%= item.asset_class || "N/A" %>
                                        </span>
                                    </td>

                                    <td><%= formatCurrency(item.invested_value) %></td>

                                    <td class="value-cell">
                                        <%= formatCurrency(item.current_value) %>
                                    </td>

                                    <td>
                                        <% if (item.profit_loss != null) { %>
                                            <span class="<%= Number(item.profit_loss) >= 0 ? 'positive' : 'negative' %>">
                                                <%= formatCurrency(item.profit_loss) %>
                                                <small>
                                                    (<%= item.profit_loss_percentage != null
                                                        ? item.profit_loss_percentage + "%"
                                                        : "N/A" %>)
                                                </small>
                                            </span>
                                        <% } else { %>
                                            N/A
                                        <% } %>
                                    </td>

                                    <td>
                                        <%= item.weight_percentage ?? "N/A" %>%
                                    </td>
                                </tr>
                            <% }) %>

                            <% if (analyticsHoldings.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="empty-table">
                                        No consolidated holdings available.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

            </div>


            <% if (hasExtraDetails) { %>

                <div class="content-card">

                    <div class="card-heading">
                        <div>
                            <h3>Investment Details</h3>
                            <p>Additional identifiers and instrument information.</p>
                        </div>
                    </div>

                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Investment</th>
                                    <th>ISIN</th>
                                    <th>Sub Category</th>
                                    <th>Quantity</th>
                                    <th>Average NAV</th>
                                    <th>Current NAV</th>
                                    <th>Folio Number</th>
                                    <th>Source</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% portfolioHoldings.forEach(item => { %>
                                    <tr>
                                        <td><%= item.name || "N/A" %></td>
                                        <td><%= item.isin || "N/A" %></td>
                                        <td><%= item.subCategory || "N/A" %></td>
                                        <td><%= item.quantity ?? "N/A" %></td>
                                        <td><%= item.averageNav ?? "N/A" %></td>
                                        <td><%= item.currentNav ?? "N/A" %></td>
                                        <td><%= item.folioNumber || "N/A" %></td>
                                        <td><%= item.source || "N/A" %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                </div>

            <% } %>

        </section>


        <!-- ANALYTICS AND RISK -->

        <section id="risk-analysis" class="page-section">

            <div class="page-heading">
                <div>
                    <span class="eyebrow">PORTFOLIO INTELLIGENCE</span>
                    <h1>Analytics & Risk</h1>
                    <p>Understand concentration, liquidity and configured risk observations.</p>
                </div>
            </div>


            <% if (safeRisk) { %>

                <div class="metric-grid risk-metric-grid">

    <div class="metric-card">
        <div class="metric-top">
            <span>HHI Concentration</span>
            <span class="metric-icon">◉</span>
        </div>

        <h2>
            <%= safeRisk.concentration?.hhi ?? "N/A" %>
        </h2>

        <small>Concentration index, 0–10,000 scale</small>
    </div>


    <div class="metric-card">
        <div class="metric-top">
            <span>Top 3 Holdings</span>
            <span class="metric-icon">▥</span>
        </div>

        <h2>
            <%= safeRisk.concentration?.top_three_concentration ?? "N/A" %>%
        </h2>

        <small>Combined portfolio weight</small>
    </div>


    <div class="metric-card">
        <div class="metric-top">
            <span>Cash / Liquid</span>
            <span class="metric-icon">◌</span>
        </div>

        <h2>
            <%= safeRisk.liquidity?.percentage ?? "N/A" %>%
        </h2>

        <small>Reported allocation only</small>
    </div>


    <div class="metric-card">
        <div class="metric-top">
            <span>Risk Observations</span>
            <span class="metric-icon">!</span>
        </div>

        <h2>
            <%= safeRisk.risk_flag_count ?? riskFlags.length %>
        </h2>

        <small>Configured thresholds triggered</small>
    </div>

</div>


                <!-- RISK OBSERVATIONS -->

                <div class="content-card">

                    <div class="card-heading">
                        <div>
                            <h3>Risk Observations</h3>
                            <p>Rules-based observations generated from available portfolio data.</p>
                        </div>
                    </div>

                    <% if (riskFlags.length === 0) { %>
                        <div class="notice notice-info">
                            No configured risk thresholds were breached.
                            This does not mean the portfolio is risk-free.
                        </div>
                    <% } %>

                    <% riskFlags.forEach(flag => { %>
                        <div class="risk-item">
                            <div class="risk-indicator"></div>

                            <div>
                                <strong>
                                    <%= flag.severity || "Observation" %>
                                    ·
                                    <%= flag.type || "Risk observation" %>
                                </strong>

                                <p><%= flag.message || "" %></p>
                            </div>
                        </div>
                    <% }) %>

                    <% if (safeRisk.interpretation) { %>
                        <p class="muted-text"><%= safeRisk.interpretation %></p>
                    <% } %>

                </div>


                <!-- AI RISK EXPLANATION -->

                <div class="content-card ai-card">

                    <div class="ai-card-header">
                        <div class="ai-icon">✧</div>

                        <div>
                            <h3>AI Risk Explanation</h3>
                            <p>Understand what your portfolio metrics indicate.</p>
                        </div>
                    </div>

                    <button type="button" id="explain-risk-btn" class="primary-btn">
                        Generate explanation
                    </button>

                    <div id="risk-explanation-result" class="ai-result"></div>

                </div>


                <div class="disclaimer">
                    <strong>Important:</strong>
                    <%= safeRisk.disclaimer ||
                        "These are illustrative analytics based on available portfolio data. They are not investment advice or a suitability assessment." %>
                </div>

            <% } else { %>

                <div class="empty-state large-empty-state">
                    <span>⌁</span>
                    <h3>Risk analysis unavailable</h3>
                    <p>Upload and process financial documents to view portfolio risk metrics.</p>
                </div>

            <% } %>

        </section>


        <!-- DOCUMENT MANAGEMENT -->

        <section id="documents" class="page-section">

            <div class="page-heading">
                <div>
                    <span class="eyebrow">FINANCIAL DATA HUB</span>
                    <h1>Documents</h1>
                    <p>Upload and manage your financial records in one place.</p>
                </div>
            </div>


            <!-- UPLOAD -->

            <div class="content-card upload-card">

                <div class="upload-icon">↑</div>

                <h3>Upload Financial Documents</h3>

                <p>
                    Add PDF or Excel statements to extract and organize
                    your financial information.
                </p>

                <form
                    action="/upload"
                    method="POST"
                    enctype="multipart/form-data"
                    id="upload-form"
                    class="upload-form"
                >

                    <input
                        type="file"
                        name="files"
                        accept=".pdf,.xlsx"
                        multiple
                        required
                    >

                    <button type="submit" class="primary-btn">
                        Upload documents
                    </button>

                </form>

                <small class="upload-help">
                    Supported formats: PDF and XLSX · Maximum 10 MB per file
                </small>

            </div>


            <!-- DOCUMENT LIBRARY -->

            <div class="content-card">

                <div class="card-heading">
                    <div>
                        <h3>My Financial Documents</h3>
                        <p>View processing status and manage uploaded files.</p>
                    </div>

                    <span class="count-badge" id="document-count">
                        Your documents
                    </span>
                </div>

                <div id="document-list" class="document-list">
                    <div class="loading-state">Loading documents...</div>
                </div>

            </div>

        </section>


        <!-- RECONCILIATION -->

        <section id="reconciliation" class="page-section">

            <div class="page-heading">
                <div>
                    <span class="eyebrow">DATA QUALITY & VERIFICATION</span>
                    <h1>Reconciliation</h1>
                    <p>Review matched records and differences across uploaded documents.</p>
                </div>
            </div>


            <div class="metric-grid">

                <div class="metric-card">
                    <div class="metric-top">
                        <span>Extracted Records</span>
                        <span class="metric-icon">▤</span>
                    </div>

                    <h2><%= safeAllDocumentHoldings.length %></h2>
                    <small>Across uploaded documents</small>
                </div>

                <div class="metric-card">
                    <div class="metric-top">
                        <span>Duplicate Groups</span>
                        <span class="metric-icon">⇄</span>
                    </div>

                    <h2><%= safeDuplicateRecords.length %></h2>
                    <small>Matched investment records</small>
                </div>

                <div class="metric-card">
                    <div class="metric-top">
                        <span>Valuation Differences</span>
                        <span class="metric-icon">!</span>
                    </div>

                    <h2><%= safeConflicts.length %></h2>
                    <small>Records requiring attention</small>
                </div>

                <div class="metric-card">
                    <div class="metric-top">
                        <span>Folio Verification Issues</span>
                        <span class="metric-icon">!</span>
                    </div>
                    <h2><%= folioVerificationIssues.length %></h2>
                    <small>Explicit KYC / nominee exceptions</small>
                </div>

                <div class="metric-card">
                    <div class="metric-top">
                        <span>Source Documents</span>
                        <span class="metric-icon">▧</span>
                    </div>

                    <h2><%= sourceDocumentCount %></h2>
                    <small>Documents containing extracted records</small>
                </div>

            </div>


            <!-- DUPLICATE RECORDS -->

            <div class="content-card">

                <div class="card-heading">
                    <div>
                        <h3>Matched Investment Records</h3>
                        <p>Records identified as belonging to the same investment.</p>
                    </div>
                </div>

                <% if (safeDuplicateRecords.length > 0) { %>

                    <% safeDuplicateRecords.forEach(group => { %>

                        <div class="reconciliation-item">
                            <div>
                                <strong><%= getConflictName(group) %></strong>

                                <p>
                                    Matched records:
                                    <%= group.records?.length ?? group.count ?? "Multiple" %>
                                </p>

                                <small>
                                    Selected source: <%= getSelectedDocument(group) %>
                                </small>
                            </div>

                            <span class="category-tag">Matched</span>
                        </div>

                    <% }) %>

                <% } else { %>

                    <div class="empty-state">
                        <span>⇄</span>
                        <p>No duplicate groups reported.</p>
                    </div>

                <% } %>

            </div>


            <!-- CONFLICTS -->

            <div class="content-card">

                <div class="card-heading">
                    <div>
                        <h3>Valuation Differences</h3>
                        <p>Review differences reported across your documents.</p>
                    </div>
                </div>

                <% if (safeConflicts.length > 0) { %>

                    <% safeConflicts.forEach(conflict => {
                        const values = getConflictValues(conflict);
                    %>

                        <div class="conflict-item">

                            <div class="conflict-heading">
                                <strong><%= getConflictName(conflict) %></strong>
                                <span class="warning-tag">Review required</span>
                            </div>

                            <p><%= getConflictMessage(conflict) %></p>

                            <% if (values.length > 0) { %>
                                <div class="conflict-values">
                                    <span>Reported values</span>

                                    <strong>
                                        <%= values.map(value =>
                                            formatCurrency(
                                                typeof value === "object"
                                                    ? value?.currentValue
                                                    : value
                                            )
                                        ).join(" / ") %>
                                    </strong>
                                </div>
                            <% } %>

                            <small>
                                Selected source: <%= getSelectedDocument(conflict) %>
                            </small>

                        </div>

                    <% }) %>

                <% } else { %>

                    <div class="empty-state">
                        <span>✓</span>
                        <p>No valuation differences were reported by reconciliation.</p>
                    </div>

                <% } %>

            </div>


            <!-- FOLIO VERIFICATION -->
            <div class="content-card">
                <div class="card-heading">
                    <div>
                        <h3>Folio Verification</h3>
                        <p>Nominee and KYC details explicitly reported in uploaded statement schedules. This is an administrative check, not a valuation difference.</p>
                    </div>
                </div>

                <% if (folioVerificationRecords.length > 0) { %>
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Folio</th>
                                    <th>AMC</th>
                                    <th>Nominee Status</th>
                                    <th>KYC / PAN Status</th>
                                    <th>Verification</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% folioVerificationRecords.forEach(item => {
                                    const kyc = String(item.kyc_status || "").toLowerCase();
                                    const nominee = String(item.nominee_status || "").toLowerCase();
                                    const issue = Boolean(item.verification_note) ||
                                        (kyc && !/^(kyc )?ok$|^verified$|^complete$/.test(kyc)) ||
                                        (nominee && !/^(registered|not applicable|n a)$/.test(nominee));
                                %>
                                    <tr>
                                        <td><%= item.folio_number %></td>
                                        <td><%= item.amc || "N/A" %></td>
                                        <td><%= item.nominee_status || "Not reported" %></td>
                                        <td><%= item.kyc_status || "Not reported" %></td>
                                        <td>
                                            <span class="<%= issue ? 'warning-tag' : 'category-tag' %>">
                                                <%= item.verification_note ? "Manual review" : issue ? "Action required" : "No issue reported" %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% if (folioVerificationIssues.length > 0) { %>
                        <div class="notice notice-info">
                            <strong><%= folioVerificationIssues.length %> folio(s) need administrative follow-up.</strong>
                            Review the original AMC statement before taking action. WealthWise does not change or submit KYC / nominee details.
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="empty-state">
                        <span>✓</span>
                        <p>No folio-level KYC or nominee metadata was provided by the uploaded documents. Status is unknown, not verified.</p>
                    </div>
                <% } %>
            </div>


            <!-- ALL EXTRACTED RECORDS -->

            <div class="content-card">

                <div class="card-heading">
                    <div>
                        <h3>All Extracted Investment Records</h3>
                        <p>Original records from uploaded documents, including duplicates.</p>
                    </div>
                </div>

                <div class="table-container">

                    <table>
                        <thead>
                            <tr>
                                <th>Investment</th>
                                <th>Asset Class</th>
                                <th>ISIN</th>
                                <th>Quantity</th>
                                <th>Invested Value</th>
                                <th>Current Value</th>
                                <th>Profit / Loss</th>
                                <th>Folio</th>
                                <th>Source Document</th>
                                <th>Data Type</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% safeAllDocumentHoldings.forEach(item => { %>

                                <tr>
                                    <td><%= item.name || "Unnamed investment" %></td>
                                    <td><%= item.assetClass || "N/A" %></td>
                                    <td><%= item.isin || "N/A" %></td>
                                    <td><%= item.quantity ?? "N/A" %></td>
                                    <td><%= formatCurrency(item.investedValue) %></td>
                                    <td><%= formatCurrency(item.currentValue) %></td>
                                    <td><%= formatCurrency(item.profitLoss) %></td>
                                    <td><%= item.folioNumber || "N/A" %></td>

                                    <td>
                                        <%= item.documentName || "N/A" %>

                                        <% if (item.rowNumber != null) { %>
                                            <small>(Row <%= item.rowNumber %>)</small>
                                        <% } %>
                                    </td>

                                    <td>
                                        <span class="category-tag">
                                            <%= item.isDemo ? "Demo" : "Actual" %>
                                        </span>
                                    </td>
                                </tr>

                            <% }) %>

                            <% if (safeAllDocumentHoldings.length === 0) { %>
                                <tr>
                                    <td colspan="10" class="empty-table">
                                        No extracted investment records available.
                                    </td>
                                </tr>
                            <% } %>

                        </tbody>
                    </table>

                </div>

            </div>

        </section>


        <!-- AI ASSISTANT -->

        <section id="assistant" class="page-section">

            <div class="page-heading">
                <div>
                    <span class="eyebrow">WEALTHWISE INTELLIGENCE</span>
                    <h1>AI Assistant</h1>
                    <p>Ask questions about your uploaded financial documents.</p>
                </div>
            </div>


            <div class="assistant-layout">

                <div class="content-card assistant-card">

                    <div class="assistant-header">
                        <div class="ai-icon">✧</div>

                        <div>
                            <h3>WealthWise AI</h3>
                            <span class="assistant-status">
                                <span class="status-dot"></span>
                                Document intelligence
                            </span>
                        </div>

                        <button
                            type="button"
                            id="load-history-btn"
                            class="secondary-btn history-btn"
                        >
                            View history
                        </button>
                    </div>


                    <div id="chat-history" class="chat-history"></div>


                    <div id="chat-box" class="chat-box">

                        <div class="assistant-welcome">
                            <div class="ai-icon">✧</div>
                            <h3>How can I help you?</h3>
                            <p>
                                Ask about your uploaded statements,
                                investment holdings or financial records.
                            </p>
                        </div>

                    </div>


                    <form id="chat-form" class="chat-form">

                        <input
                            type="text"
                            id="question"
                            name="question"
                            placeholder="Ask about your financial documents..."
                            required
                            autocomplete="off"
                        >

                        <button type="submit" class="primary-btn">
                            Ask AI →
                        </button>

                    </form>

                    <small class="assistant-disclaimer">
                        Responses are based on retrieved document information.
                        Always verify important financial figures against original records.
                    </small>

                </div>

            </div>

        </section>


        <!-- FOOTER -->

        <footer class="app-footer">
            <span>WealthWise AI</span>
            <span>Financial Intelligence Platform</span>
            <span>Not investment advice</span>
        </footer>

    </main>

</div>


<!-- DATA FOR CHARTS -->

<% if (safeAnalytics) { %>

    <script>
        window.wealthWiseData = {
            allocation: <%- safeJson(allocationData) %>,
            holdings: <%- safeJson(analyticsHoldings) %>
        };
    </script>

<% } %>

<script src="/app.js"></script>

</body>
</html>