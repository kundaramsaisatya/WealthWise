
<%
    const safeAnalytics =
        typeof analytics !== "undefined" ? analytics : null;

    const safeRisk =
        typeof risk !== "undefined" ? risk : null;

    const safeError =
        typeof error !== "undefined" ? error : null;

    const safePortfolio =
        typeof portfolio !== "undefined" && portfolio
            ? portfolio
            : { holdings: [], totalValue: 0, currency: "INR" };

    const safeAllDocumentHoldings =
        typeof allDocumentHoldings !== "undefined" &&
        Array.isArray(allDocumentHoldings)
            ? allDocumentHoldings
            : [];

    const safeDuplicateRecords =
        typeof duplicateRecords !== "undefined" &&
        Array.isArray(duplicateRecords)
            ? duplicateRecords
            : [];

    const safeConflicts =
        typeof conflicts !== "undefined" &&
        Array.isArray(conflicts)
            ? conflicts
            : [];

    const portfolioHoldings = Array.isArray(safePortfolio.holdings)
        ? safePortfolio.holdings
        : [];

    const analyticsHoldings =
        safeAnalytics && Array.isArray(safeAnalytics.holdings)
            ? safeAnalytics.holdings
            : [];

    const formatCurrency = value => {
        if (
            value === null ||
            value === undefined ||
            value === "" ||
            !Number.isFinite(Number(value))
        ) {
            return "N/A";
        }

        return "₹" + Number(value).toLocaleString("en-IN", {
            maximumFractionDigits: 2
        });
    };

    const totalValue = Number(
        safeAnalytics?.total_value ??
        safePortfolio.totalValue ??
        0
    );

    const allInvestedValuesAvailable =
        portfolioHoldings.length > 0 &&
        portfolioHoldings.every(item =>
            item.investedValue !== null &&
            item.investedValue !== undefined &&
            Number.isFinite(Number(item.investedValue))
        );

    const totalInvested = allInvestedValuesAvailable
        ? portfolioHoldings.reduce(
            (sum, item) => sum + Number(item.investedValue),
            0
        )
        : null;

    const totalProfitLoss =
        totalInvested !== null
            ? totalValue - totalInvested
            : null;

    const hasExtraDetails = portfolioHoldings.some(item =>
        item.subCategory ||
        item.isin ||
        item.folioNumber ||
        item.source ||
        item.averageNav != null ||
        item.currentNav != null
    );

    const sourceDocumentCount = new Set(
        safeAllDocumentHoldings
            .map(item => item.documentName)
            .filter(Boolean)
    ).size;

    const portfolioMode = safePortfolio.isDemo
        ? "Demo Data"
        : "Actual Data";

    const safeJson = value =>
        JSON.stringify(value ?? []).replace(/</g, "\\u003c");

    const getConflictName = item =>
        item?.name ||
        item?.holdingName ||
        item?.investment ||
        item?.isin ||
        "Investment record";

    const getConflictMessage = item =>
        item?.message ||
        item?.reason ||
        "Different values were found across uploaded documents.";

    const getConflictValues = item => {
        if (Array.isArray(item?.values)) {
            return item.values;
        }

        if (Array.isArray(item?.conflictingValues)) {
            return item.conflictingValues.map(value =>
                typeof value === "object"
                    ? value.currentValue
                    : value
            );
        }

        return [];
    };

    const getSelectedDocument = item =>
        item?.selectedDocument ||
        item?.selectedSource ||
        item?.documentName ||
        "Not specified";
%>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>WealthWise AI</title>

    <link rel="stylesheet" href="/style.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

    <!-- Sidebar -->

    <aside class="sidebar">

        <h2>WealthWise<span>AI</span></h2>

        <p>WEALTH MANAGEMENT</p>
        <div>
            <%= user.name %>
        </div>
    
        <nav>
            <a href="/">Dashboard</a>
            <a href="#portfolio">Portfolio</a>
            <a href="#documents">Documents</a>
            <a href="#document-library">My Documents</a>
            <a href="#all-investments">All Investment Records</a>
            <a href="#reconciliation">Reconciliation</a>
            <a href="#risk-analysis">Risk Analysis</a>
            <a href="#assistant">AI Assistant</a>

            
            
            <form action="/logout" method="POST">
                
                <button type="submit" class="logout-btn">
                    Logout
                </button>
            </form>
        </nav>

        

    </aside>

    <!-- Main Content -->

    <main class="main">

        <header>

            <div>
                <h1>Portfolio Overview</h1>
                <p>Your intelligent wealth management workspace</p>
            </div>

            <span class="status">
                ● <%= portfolioMode %>
            </span>

        </header>

        <!-- Error -->

        <% if (safeError) { %>
            <p class="error"><%= safeError %></p>
        <% } %>

        <!-- Dashboard Analytics -->

        <% if (safeAnalytics) { %>

            <!-- Summary Cards -->

            <section class="stats">

                <div class="card">
                    <p>Total Portfolio Value</p>

                    <h2>
                        <%= formatCurrency(safeAnalytics.total_value ?? totalValue) %>
                    </h2>
                </div>

                <div class="card">
                    <p>Total Invested</p>

                    <h2>
                        <%= totalInvested !== null
                            ? formatCurrency(totalInvested)
                            : "N/A" %>
                    </h2>
                </div>

                <div class="card">
                    <p>Portfolio Profit / Loss</p>

                    <h2>
                        <% if (totalProfitLoss !== null) { %>
                            <span class="<%= totalProfitLoss >= 0 ? 'positive' : 'negative' %>">
                                <%= formatCurrency(totalProfitLoss) %>
                            </span>
                        <% } else { %>
                            N/A
                        <% } %>
                    </h2>
                </div>

                <div class="card">
                    <p>Holdings</p>
                    <h2><%= analyticsHoldings.length %></h2>
                    <small>Consolidated holdings</small>
                </div>

            </section>

            <!-- Asset Allocation -->

            <section class="panel" id="portfolio">

                <h2>Asset Allocation</h2>

                <% if (
                    Array.isArray(safeAnalytics.asset_allocation) &&
                    safeAnalytics.asset_allocation.length > 0
                ) { %>

                    <% safeAnalytics.asset_allocation.forEach(item => { %>

                        <div class="allocation">

                            <div class="allocation-label">
                                <span><%= item.asset_class %></span>
                                <strong><%= item.percentage %>%</strong>
                            </div>

                            <div class="progress">
                                <div style="width: <%= Math.min(100, Math.max(0, Number(item.percentage) || 0)) %>%"></div>
                            </div>

                        </div>

                    <% }) %>

                <% } else { %>

                    <p>No asset allocation data available.</p>

                <% } %>

            </section>

            <!-- Charts -->

            <section class="charts-grid">

                <div class="panel">
                    <h2>Asset Distribution</h2>
                    <canvas id="allocationChart"></canvas>
                </div>

                <div class="panel">
                    <h2>Holding-wise Investment</h2>
                    <canvas id="holdingsChart"></canvas>
                </div>

            </section>

            <!-- Portfolio Holdings -->

            <section class="panel">

                <h2>Portfolio Holdings</h2>

                <div class="table-wrap">

                    <table>

                        <thead>
                            <tr>
                                <th>Holding</th>
                                <th>Asset Class</th>
                                <th>Invested Value</th>
                                <th>Current Value</th>
                                <th>Profit / Loss</th>
                                <th>Weight</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% analyticsHoldings.forEach(item => { %>

                                <tr>

                                    <td><%= item.name || "Unnamed investment" %></td>

                                    <td><%= item.asset_class || "N/A" %></td>

                                    <td>
                                        <%= formatCurrency(item.invested_value) %>
                                    </td>

                                    <td>
                                        <%= formatCurrency(item.current_value) %>
                                    </td>

                                    <td>

                                        <% if (item.profit_loss != null) { %>

                                            <span class="<%= Number(item.profit_loss) >= 0 ? 'positive' : 'negative' %>">

                                                <%= formatCurrency(item.profit_loss) %>

                                                (<%= item.profit_loss_percentage != null
                                                    ? item.profit_loss_percentage + "%"
                                                    : "N/A" %>)

                                            </span>

                                        <% } else { %>

                                            N/A

                                        <% } %>

                                    </td>

                                    <td>
                                        <%= item.weight_percentage ?? 0 %>%
                                    </td>

                                </tr>

                            <% }) %>

                            <% if (analyticsHoldings.length === 0) { %>
                                <tr>
                                    <td colspan="6">No consolidated holdings available.</td>
                                </tr>
                            <% } %>

                        </tbody>

                    </table>

                </div>

            </section>

            <!-- Additional Investment Details -->

            <% if (hasExtraDetails) { %>

                <section class="panel">

                    <h2>Additional Investment Details</h2>

                    <div class="table-wrap">

                        <table>

                            <thead>
                                <tr>
                                    <th>Investment</th>
                                    <th>ISIN</th>
                                    <th>Sub Category</th>
                                    <th>Quantity</th>
                                    <th>Average NAV</th>
                                    <th>Current NAV</th>
                                    <th>Folio Number</th>
                                    <th>Source</th>
                                </tr>
                            </thead>

                            <tbody>

                                <% portfolioHoldings.forEach(item => { %>

                                    <tr>
                                        <td><%= item.name || "N/A" %></td>
                                        <td><%= item.isin || "N/A" %></td>
                                        <td><%= item.subCategory || "N/A" %></td>
                                        <td><%= item.quantity ?? "N/A" %></td>
                                        <td><%= item.averageNav ?? "N/A" %></td>
                                        <td><%= item.currentNav ?? "N/A" %></td>
                                        <td><%= item.folioNumber || "N/A" %></td>
                                        <td><%= item.source || "N/A" %></td>
                                    </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                </section>

            <% } %>

        <% } else { %>

            <section class="panel">

                <h2>Welcome to WealthWise AI</h2>

                <p>
                    Upload your financial statement to view your portfolio,
                    asset allocation, investment details and risk analysis.
                </p>

            </section>

        <% } %>

        <!-- All Extracted Investment Records -->

        <section class="panel" id="all-investments">

            <h2>All Extracted Investment Records</h2>

            <p>
                Complete investment records extracted from all uploaded
                documents, including duplicate entries.
            </p>

            <div class="stats">

                <div class="card">
                    <p>Total Extracted Records</p>
                    <h2><%= safeAllDocumentHoldings.length %></h2>
                </div>

                <div class="card">
                    <p>Source Documents</p>
                    <h2><%= sourceDocumentCount %></h2>
                </div>

            </div>

            <% if (safeAllDocumentHoldings.length > 0) { %>

                <div class="table-wrap">

                    <table>

                        <thead>
                            <tr>
                                <th>Investment</th>
                                <th>Asset Class</th>
                                <th>ISIN</th>
                                <th>Quantity</th>
                                <th>Invested Value</th>
                                <th>Current Value</th>
                                <th>Profit / Loss</th>
                                <th>Folio</th>
                                <th>Source Document</th>
                                <th>Data Type</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% safeAllDocumentHoldings.forEach(item => { %>

                                <tr>

                                    <td><%= item.name || "Unnamed investment" %></td>

                                    <td><%= item.assetClass || "N/A" %></td>

                                    <td><%= item.isin || "N/A" %></td>

                                    <td><%= item.quantity ?? "N/A" %></td>

                                    <td>
                                        <%= formatCurrency(item.investedValue) %>
                                    </td>

                                    <td>
                                        <%= formatCurrency(item.currentValue) %>
                                    </td>

                                    <td>
                                        <%= formatCurrency(item.profitLoss) %>
                                    </td>

                                    <td>
                                        <%= item.folioNumber || "N/A" %>
                                    </td>

                                    <td>
                                        <%= item.documentName || "N/A" %>
                                        <% if (item.rowNumber != null) { %>
                                            <small> (Row <%= item.rowNumber %>)</small>
                                        <% } %>
                                    </td>

                                    <td>
                                        <%= item.isDemo ? "Demo" : "Actual" %>
                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } else { %>

                <p>No investment records extracted yet.</p>

            <% } %>

        </section>

        <!-- Portfolio Reconciliation -->

        <section class="panel" id="reconciliation">

            <h2>Portfolio Reconciliation</h2>

            <p>
                Review matched investment records and differences in
                reported valuations across uploaded documents.
            </p>

            <div class="stats">

                <div class="card">
                    <p>Duplicate Groups</p>
                    <h2><%= safeDuplicateRecords.length %></h2>
                </div>

                <div class="card">
                    <p>Valuation Differences</p>
                    <h2><%= safeConflicts.length %></h2>
                </div>

            </div>

            <% if (safeDuplicateRecords.length > 0) { %>

                <h3>Matched Investment Records</h3>

                <% safeDuplicateRecords.forEach(group => { %>

                    <div class="risk">

                        <strong>
                            <%= getConflictName(group) %>
                        </strong>

                        <p>
                            Matched records:
                            <%= group.records?.length ?? group.count ?? "Multiple" %>
                        </p>

                        <small>
                            Selected source:
                            <%= getSelectedDocument(group) %>
                        </small>

                    </div>

                <% }) %>

            <% } %>

            <% if (safeConflicts.length > 0) { %>

                <h3>Valuation Differences</h3>

                <% safeConflicts.forEach(conflict => { %>

                    <div class="risk">

                        <strong>
                            <%= getConflictName(conflict) %>
                        </strong>

                        <p>
                            <%= getConflictMessage(conflict) %>
                        </p>

                        <% const values = getConflictValues(conflict); %>

                        <% if (values.length > 0) { %>

                            <p>
                                Reported values:

                                <%= values.map(value =>
                                    formatCurrency(
                                        typeof value === "object"
                                            ? value?.currentValue
                                            : value
                                    )
                                ).join(" / ") %>
                            </p>

                        <% } %>

                        <small>
                            Selected source:
                            <%= getSelectedDocument(conflict) %>
                        </small>

                    </div>

                <% }) %>

            <% } %>

            <% if (
                safeDuplicateRecords.length === 0 &&
                safeConflicts.length === 0
            ) { %>

                <p>
                    No duplicate groups or valuation differences were
                    reported by the reconciliation process.
                </p>

            <% } %>

        </section>

        <!-- Risk Analysis -->

        <% if (safeRisk) { %>

            <section class="panel" id="risk-analysis">

                <h2>Portfolio Risk Intelligence</h2>

                <div class="stats">

                    <div class="card">
                        <p>HHI Concentration</p>

                        <h2><%= safeRisk.hhi ?? "N/A" %></h2>

                        <small>
                            Normalized: <%= safeRisk.normalized_hhi ?? "N/A" %>
                        </small>
                    </div>

                    <div class="card">
                        <p>Top 3 Holdings</p>

                        <h2>
                            <%= safeRisk.top_three_concentration ?? 0 %>%
                        </h2>
                    </div>

                    <div class="card">
                        <p>Liquidity</p>

                        <h2>
                            <%= safeRisk.liquidity_percentage ?? 0 %>%
                        </h2>
                    </div>

                    <div class="card">
                        <p>Risk Flags</p>

                        <h2>
                            <%= Array.isArray(safeRisk.risk_flags)
                                ? safeRisk.risk_flags.length
                                : 0 %>
                        </h2>
                    </div>

                </div>

                <!-- AI Risk Explanation -->

                <div class="ai-explanation">

                    <h3>AI Risk Explanation</h3>

                    <p>
                        Understand your portfolio metrics using AI.
                    </p>

                    <button type="button" id="explain-risk-btn">
                        Explain Portfolio Risk
                    </button>

                    <div id="risk-explanation-result"></div>

                </div>

                <% if (
                    !safeRisk.risk_flags ||
                    safeRisk.risk_flags.length === 0
                ) { %>

                    <div class="risk">
                        No configured risk thresholds were breached.
                    </div>

                <% } %>

                <% (safeRisk.risk_flags || []).forEach(flag => { %>

                    <div class="risk">

                        <strong>
                            <%= flag.severity || "INFO" %>:
                            <%= flag.type || "Risk observation" %>
                        </strong>

                        <p><%= flag.message || "" %></p>

                    </div>

                <% }) %>

                <p>
                    <small>
                        <%= safeRisk.interpretation || "" %>
                    </small>
                </p>

            </section>

        <% } %>

        <!-- Analytics Risk Flags -->

        <% if (safeAnalytics) { %>

            <section class="panel">

                <h2>Portfolio Insights</h2>

                <% if (
                    !safeAnalytics.risk_flags ||
                    safeAnalytics.risk_flags.length === 0
                ) { %>

                    <p>
                        No threshold-based risk flags triggered by
                        the current rules.
                    </p>

                <% } %>

                <% (safeAnalytics.risk_flags || []).forEach(flag => { %>

                    <div class="risk">
                        <strong><%= flag.type || "Risk observation" %></strong>
                        <p><%= flag.message || "" %></p>
                    </div>

                <% }) %>

                <small>
                    <%= safeAnalytics.disclaimer || "" %>
                </small>

            </section>

        <% } %>

        <!-- Document Upload -->

        <section class="panel" id="documents">

            <h2>Upload Financial Documents</h2>

            <p>
                Upload multiple PDF or Excel financial statements together.
            </p>

            <form
                action="/upload"
                method="POST"
                enctype="multipart/form-data"
                id="upload-form"
            >

                <input
                    type="file"
                    name="files"
                    accept=".pdf,.xlsx"
                    multiple
                    required
                >

                <button type="submit">
                    Upload Documents
                </button>

            </form>

            <small>
                Supported formats: PDF and XLSX.
                Maximum size: 10 MB per file.
            </small>

        </section>

        <!-- Document Manager -->

        <section class="panel" id="document-library">

            <h2>My Financial Documents</h2>

            <p>
                View all your uploaded financial statements and their
                processing status.
            </p>

            <div id="document-list">
                Loading documents...
            </div>

        </section>

        <!-- AI Assistant -->

        <section class="panel" id="assistant">

            <h2>WealthWise AI Assistant</h2>

            <p>
                Ask questions about your uploaded financial documents.
            </p>

            <button id="load-history-btn" type="button">
                View Previous Conversations
            </button>

            <div id="chat-history"></div>

            <div id="chat-box"></div>

            <form id="chat-form">

                <input
                    type="text"
                    id="question"
                    name="question"
                    placeholder="Ask about your portfolio..."
                    required
                >

                <button type="submit">
                    Ask AI
                </button>

            </form>

        </section>

        <!-- Footer -->

        <footer>
            WealthWise AI · Financial Intelligence Platform · Not investment advice
        </footer>

    </main>

    <!-- Chart.js -->

    <% if (safeAnalytics) { %>

        <script>

            const allocationData =
                <%- safeJson(safeAnalytics.asset_allocation) %>;

            const holdingsData =
                <%- safeJson(analyticsHoldings) %>;

            // Asset Distribution

            const allocationCanvas =
                document.getElementById("allocationChart");

            if (allocationCanvas && allocationData.length > 0) {

                new Chart(allocationCanvas, {

                    type: "doughnut",

                    data: {

                        labels: allocationData.map(item =>
                            item.asset_class || "Other"
                        ),

                        datasets: [{

                            data: allocationData.map(item =>
                                Number(item.value ?? item.percentage ?? 0)
                            )

                        }]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: true,

                        cutout: "65%",

                        plugins: {

                            legend: {
                                position: "bottom"
                            }

                        }

                    }

                });

            }

            // Holding-wise Investment

            const holdingsCanvas =
                document.getElementById("holdingsChart");

            if (holdingsCanvas && holdingsData.length > 0) {

                new Chart(holdingsCanvas, {

                    type: "bar",

                    data: {

                        labels: holdingsData.map(item =>
                            item.name || "Unnamed investment"
                        ),

                        datasets: [{

                            label: "Current Market Value (₹)",

                            data: holdingsData.map(item =>
                                Number(item.current_value ?? 0)
                            )

                        }]

                    },

                    options: {

                        responsive: true,

                        indexAxis: "y",

                        plugins: {

                            legend: {
                                display: false
                            },

                            tooltip: {

                                callbacks: {

                                    label: function(context) {

                                        return "₹" +
                                            Number(context.raw).toLocaleString("en-IN");

                                    }

                                }

                            }

                        }

                    }

                });

            }

        </script>

    <% } %>

    <script src="/app.js"></script>

</body>

</html>
