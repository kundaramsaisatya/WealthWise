
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>WealthWise AI | Profile Settings</title>

    <link rel="stylesheet" href="/style.css">


</head>

<body>

<div class="profile-wrapper">

    <div class="profile-card">

        <div class="profile-header">
            <div class="brand">WEALTHWISE AI</div>

            <h1>Profile Settings</h1>

            <p>
                Personalize your portfolio risk analysis by selecting
                your investment risk preference.
            </p>
        </div>

        <% if (success) { %>
            <div class="success-message">
                ✓ Risk preference updated successfully.
            </div>
        <% } %>

        <form action="/profile/risk-tolerance" method="POST">

            <label class="section-label">
                Select Your Risk Tolerance
            </label>

            <div class="risk-options">

                <label class="risk-option">
                    <input
                        type="radio"
                        name="riskTolerance"
                        value="conservative"
                        <%= riskTolerance === "conservative" ? "checked" : "" %>
                        required
                    >

                    <div class="risk-content">
                        <h3>Conservative</h3>

                        <p>
                            Prioritizes lower portfolio risk and
                            greater emphasis on capital preservation.
                        </p>

                        <small>Lower risk preference</small>
                    </div>
                </label>

                <label class="risk-option">
                    <input
                        type="radio"
                        name="riskTolerance"
                        value="moderate"
                        <%= riskTolerance === "moderate" ? "checked" : "" %>
                        required
                    >

                    <div class="risk-content">
                        <h3>Moderate</h3>

                        <p>
                            Seeks a balance between potential returns
                            and portfolio risk.
                        </p>

                        <small>Balanced risk preference</small>
                    </div>
                </label>

                <label class="risk-option">
                    <input
                        type="radio"
                        name="riskTolerance"
                        value="aggressive"
                        <%= riskTolerance === "aggressive" ? "checked" : "" %>
                        required
                    >

                    <div class="risk-content">
                        <h3>Aggressive</h3>

                        <p>
                            Accepts higher portfolio fluctuations
                            and greater investment risk.
                        </p>

                        <small>Higher risk preference</small>
                    </div>
                </label>

            </div>

            <button type="submit" class="save-btn">
                Save Preferences →
            </button>

        </form>

        <a href="/" class="back-link">
            ← Back to Dashboard
        </a>

        <div class="disclaimer">
            Your selected preference will configure risk-analysis
            thresholds. It is not a guarantee of returns or a
            personalized investment suitability assessment.
        </div>

    </div>

</div>

</body>
</html>
